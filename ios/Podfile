require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

ENV['RCT_NEW_ARCH_ENABLED'] = '1'
ENV['RNFB_SUPPRESS_NEW_ARCHITECTURE_WARNING'] = '1'

require_relative '../node_modules/react-native-permissions/scripts/setup.rb'
setup_permissions([
  'LocationWhenInUse',
])

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Tab2wash' do
  config = use_native_modules!

  # Firebase requires these two pods to expose module maps so that
  # FirebaseCoreInternal (a Swift pod) can import them as modules
  # when building as static libraries. Scoped to avoid breaking RN C++ pods.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    mmkv_aescrypt = File.join(installer.sandbox.root, 'MMKVCore/Core/aes/AESCrypt.cpp')
    if File.exist?(mmkv_aescrypt)
      text = File.read(mmkv_aescrypt)
      new_text = text.gsub('defined(__STDC_LIB_EXT1__) || defined(MMKV_APPLE)', 'defined(__STDC_LIB_EXT1__)')
      File.write(mmkv_aescrypt, new_text)
    end
  end
end
